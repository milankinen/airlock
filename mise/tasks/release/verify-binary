#!/usr/bin/env python3
#MISE description="Verify a pre-built airlock binary was built from the expected commit"
"""Verify that a pre-built airlock binary matches the release being made.

Checks that the binary embeds the short git hash of the expected commit
(build.rs bakes `git rev-parse --short HEAD` into rodata) and that the
version slot sentinel occurs exactly once. With a version argument, also
checks that the slot holds exactly that version (i.e. after patching).

Exits non-zero on any mismatch so a release can never ship binaries from
a different commit than the one being tagged.
"""

import pathlib
import sys

SENTINEL = b"AIRLK-VER-f3a7c2"
SLOT_SIZE = 80
SHORT_HASH_LEN = 7


def fail(msg: str) -> None:
    sys.exit(f"error: {msg}")


def main() -> None:
    if len(sys.argv) not in (3, 4):
        sys.exit(f"usage: {sys.argv[0]} <binary-path> <commit-sha> [version]")
    binary = pathlib.Path(sys.argv[1])
    sha = sys.argv[2].strip().lower()
    version = sys.argv[3] if len(sys.argv) == 4 else None

    if len(sha) < SHORT_HASH_LEN or any(c not in "0123456789abcdef" for c in sha):
        fail(f"invalid commit sha {sha!r}")

    data = binary.read_bytes()

    # `git rev-parse --short` yields at least 7 hex chars, so the 7-char
    # prefix is always present in the embedded hash.
    short = sha[:SHORT_HASH_LEN].encode()
    if short not in data:
        fail(f"{binary} does not embed commit {short.decode()}; built from another commit?")

    count = data.count(SENTINEL)
    if count != 1:
        fail(f"{binary}: version sentinel found {count} times, expected 1")

    if version is not None:
        pos = data.index(SENTINEL) + len(SENTINEL)
        slot = data[pos : pos + SLOT_SIZE - len(SENTINEL)]
        actual = slot.split(b"\x00", 1)[0].decode("utf-8", errors="replace")
        if actual != version:
            fail(f"{binary}: version slot holds {actual!r}, expected {version!r}")

    suffix = f", version {version}" if version else ""
    print(f"verified {binary}: commit {short.decode()}{suffix}")


if __name__ == "__main__":
    main()
