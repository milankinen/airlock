#!/bin/bash
#MISE description="Serve zero-filled payloads to benchmark VM network download speed"
#MISE raw=true
set -euo pipefail

port="${PORT:-8080}"
py="$(command -v python3 || command -v python)" || { echo "python3 not found on PATH" >&2; exit 1; }
exec "$py" -c '
import http.server as s, sys
port = int(sys.argv[1])
class H(s.BaseHTTPRequestHandler):
    def do_GET(self):
        mb = int(self.path.strip("/") or 1024); n = mb << 20
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Length", str(n))
        self.end_headers()
        chunk = bytes(1 << 20)
        try:
            for _ in range(mb): self.wfile.write(chunk)
        except BrokenPipeError:
            pass
    def log_message(self, *a): pass
print(f"network-bench-server on 0.0.0.0:{port} - GET /<MB> (default 1024)", file=sys.stderr)
s.ThreadingHTTPServer(("0.0.0.0", port), H).serve_forever()
' "$port"
