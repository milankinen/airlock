#!/bin/bash
#MISE description="Build the CLI binary for testing"
#MISE depends=["build:initramfs", "build:kernel", "build:libkrun", "fetch:cloud-hypervisor", "build:virtiofsd", {task="build:notifier", env={NOTIFIER_BUNDLE_ID="io.github.milankinen.airlock.notify"}}]
#MISE sources=["app/airlock-cli/src/**/*.rs", "app/airlock-cli/Cargo.toml", "Cargo.toml", "Cargo.lock", "target/vm/*"]
#MISE outputs=["{{ env.CARGO_TARGET_DIR | default(value='target') }}/release/airlock"]
set -euo pipefail

cargo build -p airlock-cli --release "$@"

if [[ "$(uname -s)" == "Darwin" ]]; then
  if [[ -n "${APPLE_SIGNING_IDENTITY:-}" ]]; then
    codesign --entitlements entitlements.plist \
             --force \
             --sign "$APPLE_SIGNING_IDENTITY" \
             --identifier "airlock.cli" \
             --options runtime \
             --timestamp \
             "${CARGO_TARGET_DIR:-target}/release/airlock"
  else
    codesign --entitlements entitlements.plist --force -s - "${CARGO_TARGET_DIR:-target}/release/airlock" 2>/dev/null || true
  fi
fi
