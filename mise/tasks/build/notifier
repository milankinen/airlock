#!/bin/bash
#MISE description="Build the macOS notifier app bundle (macOS only)"
# Builds the notifier helper, puts it in the app bundle AirlockNotifier.app,
# signs the bundle ad hoc and packs it to target/vm/notifier.tar. The macOS
# airlock binary contains the tar. Other hosts do not use it: there the task
# writes an empty file, as the virtiofsd task does on macOS.
#
# Environment options (macOS only):
#  * NOTIFIER_BUNDLE_ID: bundle id of the app. Default is the dev id
#    "io.github.milankinen.airlock.dev.notify". Release builds use the
#    production id "io.github.milankinen.airlock.notify".
#  * NOTIFIER_SIGN_ID: codesign identity. Default "-" signs ad hoc. A real
#    identity (e.g. "Developer ID Application: ...") also enables the
#    hardened runtime and a secure timestamp. The identity must be in the
#    keychain search list.
#  * NOTIFIER_UNIVERSAL=1: build for aarch64 and x86_64 and join both into
#    one universal executable. Both Rust targets must be installed. Default
#    builds only for the host, which is faster for dev builds.
# The task skips the build when the stamp of the last build matches the
# sources and the options. mise cannot do this check: the dev and release
# builds give different options to the same task.
set -euo pipefail

cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/../../..}"

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "Skipping the notifier app (not macOS)"
  mkdir -p target/vm
  # Keep an existing file, so that its time does not start other builds.
  [[ -e target/vm/notifier.tar ]] || : >target/vm/notifier.tar
  exit 0
fi

root="$(pwd -P)"
target="${CARGO_TARGET_DIR:-$root/target}"
bundle_id="${NOTIFIER_BUNDLE_ID:-io.github.milankinen.airlock.dev.notify}"
exe_name="airlock-macos-notifier"
out_dir="$target/notifier"
app="$out_dir/AirlockNotifier.app"
version="$(sed -n '/^\[workspace.package\]/,/^\[/s/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"

sign_id="${NOTIFIER_SIGN_ID:--}"
universal="${NOTIFIER_UNIVERSAL:-0}"

stamp_file="$out_dir/stamp"
stamp="$(
  {
    printf '%s\n' "$bundle_id" "$sign_id" "$universal"
    find app/airlock-macos-notifier mise/tasks/build/notifier Cargo.toml Cargo.lock -type f \
      | LC_ALL=C sort | xargs shasum -a 256
  } | shasum -a 256 | cut -d ' ' -f 1
)"
if [[ -s target/vm/notifier.tar && "$(cat "$stamp_file" 2>/dev/null)" == "$stamp" ]]; then
  echo "notifier app is up to date ($bundle_id)"
  exit 0
fi

if [[ "$universal" == "1" ]]; then
  targets=(aarch64-apple-darwin x86_64-apple-darwin)
  # Check the targets first: the cargo error for a missing target is not clear.
  sysroot="$(rustc --print sysroot)"
  for t in "${targets[@]}"; do
    if [[ ! -d "$sysroot/lib/rustlib/$t" ]]; then
      echo "error: Rust target $t is not installed. Install it with: rustup target add $t" >&2
      exit 1
    fi
  done
  target_args=()
  for t in "${targets[@]}"; do
    target_args+=(--target "$t")
  done
  cargo build -p airlock-macos-notifier --release "${target_args[@]}"
else
  cargo build -p airlock-macos-notifier --release
fi

rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
if [[ "$universal" == "1" ]]; then
  # With --target, cargo writes to a sub-dir for each target.
  lipo -create -output "$app/Contents/MacOS/$exe_name" \
    "$target/aarch64-apple-darwin/release/$exe_name" \
    "$target/x86_64-apple-darwin/release/$exe_name"
else
  cp "$target/release/$exe_name" "$app/Contents/MacOS/$exe_name"
fi

# Notification Center shows the app icon in each notification. The logo is
# a 256 px square, so the largest size is 256.
logo="$root/app/airlock-macos-notifier/logo.png"
iconset="$out_dir/AppIcon.iconset"
rm -rf "$iconset"
mkdir -p "$iconset"
for size in 16 32 128 256; do
  sips -z "$size" "$size" "$logo" --out "$iconset/icon_${size}x${size}.png" >/dev/null
done
for size in 16 32 128; do
  double=$((size * 2))
  sips -z "$double" "$double" "$logo" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil --convert icns --output "$app/Contents/Resources/AppIcon.icns" "$iconset"
rm -rf "$iconset"

# LSUIElement: no Dock icon and no menu bar.
cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>$bundle_id</string>
  <key>CFBundleName</key>
  <string>Airlock</string>
  <key>CFBundleDisplayName</key>
  <string>Airlock</string>
  <key>CFBundleExecutable</key>
  <string>$exe_name</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleVersion</key>
  <string>$version</string>
  <key>CFBundleShortVersionString</key>
  <string>$version</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>LSUIElement</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
</dict>
</plist>
PLIST
sign_args=(--force --sign "$sign_id" --identifier "$bundle_id")
if [[ "$sign_id" != "-" ]]; then
  # Developer ID signatures need the hardened runtime and a secure
  # timestamp for notarization and Gatekeeper.
  sign_args+=(--options runtime --timestamp)
fi
codesign "${sign_args[@]}" "$app"
codesign --verify --deep --strict "$app"

# Plain tar, without the macOS metadata files: airlock refuses other entry
# types than files and directories. The signature is in normal files of the
# bundle, so the tar keeps it.
mkdir -p "$root/target/vm"
tmp_tar="$out_dir/notifier.tar.tmp"
# Older bsdtar versions do not know all flags: use only the known ones.
# COPYFILE_DISABLE=1 alone already stops the metadata files.
tar_flags=""
for flag in --no-mac-metadata --no-xattrs; do
  # An unknown flag fails this empty archive.
  if tar "$flag" -c -f /dev/null -T /dev/null 2>/dev/null; then
    tar_flags="$tar_flags $flag"
  fi
done
# shellcheck disable=SC2086 # word splitting of the flags is intended
COPYFILE_DISABLE=1 tar $tar_flags -c -f "$tmp_tar" -C "$out_dir" AirlockNotifier.app
mv -f "$tmp_tar" "$root/target/vm/notifier.tar"
echo "$stamp" >"$stamp_file"
echo "notifier app: $app ($bundle_id)"
