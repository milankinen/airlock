#!/bin/bash
#MISE description="Build the libkrun dynamic library (macOS arm64 only)"
# The macOS arm64 airlock binary embeds the library. Other hosts get an
# empty file.
#
# Signing: with APPLE_SIGNING_IDENTITY set, the task signs with the
# Developer ID, hardened runtime and timestamp. Otherwise it signs ad hoc.
# Library validation loads only libraries with the same Team ID, so the
# library must be signed before the embed.
# The task does not see a change of identity. Use `--force` to sign again.
#MISE sources=["mise/tasks/build/libkrun", "app/vm-libkrun/*"]
#MISE outputs=["target/vm/libkrun.dylib"]
set -euo pipefail

mkdir -p target/vm
OUTPUT="target/vm/libkrun.dylib"

# libkrun supports macOS only on Apple silicon.
if [[ "$(uname -s)" != "Darwin" || "$(uname -m)" != "arm64" ]]; then
  echo "Skipping libkrun (not macOS arm64)"
  touch "$OUTPUT"
  exit 0
fi

# One build for each build script version, shared by all worktrees. The
# cache keeps the build tree and the unsigned library.
KEY=$(shasum -a 256 app/vm-libkrun/build.sh | cut -c1-16)
CACHE="${AIRLOCK_DEV_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/airlock-dev}/libkrun/${KEY}"
mkdir -p "$CACHE"
# macOS has no flock(1). mkdir is atomic.
until mkdir "$CACHE/lock" 2>/dev/null; do
  echo "Waiting for the libkrun build of another worktree (${CACHE}/lock)..."
  sleep 5
done
trap 'rmdir "$CACHE/lock"' EXIT
if [[ -f "$CACHE/libkrun.dylib" ]]; then
  echo "Using cached libkrun (${KEY})"
else
  echo "Building libkrun (${KEY}) in ${CACHE}..."
  app/vm-libkrun/build.sh "$CACHE/src" "$CACHE/libkrun.dylib.part"
  mv "$CACHE/libkrun.dylib.part" "$CACHE/libkrun.dylib"
fi
cp "$CACHE/libkrun.dylib" "$OUTPUT"

if [[ -n "${APPLE_SIGNING_IDENTITY:-}" ]]; then
  codesign --force --sign "$APPLE_SIGNING_IDENTITY" --identifier libkrun \
    --options runtime --timestamp "$OUTPUT"
else
  codesign --force --sign - "$OUTPUT"
fi
codesign --verify --strict "$OUTPUT"
echo "libkrun: $OUTPUT ($(du -h "$OUTPUT" | cut -f1))"
