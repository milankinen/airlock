#!/bin/sh
# Minimal init: mount basic filesystems, then start supervisor.
# All VM setup (virtiofs mounts, networking, cache disk, DNS)
# is handled by the supervisor after RPC connection.
mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null
# Without a console (libkrun), fds 0-2 start closed. Fill them, so that
# later files do not take these numbers.
[ -e /proc/self/fd/0 ] || exec 0</dev/null
[ -e /proc/self/fd/1 ] || exec 1>/dev/null
[ -e /proc/self/fd/2 ] || exec 2>/dev/null
mkdir -p /dev/pts
mount -t devpts none /dev/pts 2>/dev/null
mount -t tmpfs none /tmp 2>/dev/null
mount -t tmpfs none /run 2>/dev/null
mkdir -p /sys/fs/cgroup
mount -t cgroup2 none /sys/fs/cgroup 2>/dev/null
hostname airlock
ip link set lo up 2>/dev/null

/usr/bin/airlockd

kill -TERM -1 2>/dev/null
sleep 0.2
/sbin/poweroff -f 2>/dev/null
